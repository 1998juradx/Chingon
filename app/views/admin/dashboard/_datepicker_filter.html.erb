<%= semantic_form_for :filtro, url: path, method: :get do |f| %>
  <%= f.inputs do %>
    <%= f.input :desde, as: :string, label: "Desde", input_html: { type: "date" } %>
    <%= f.input :hasta, as: :string, label: "Hasta", input_html: { type: "date" } %>
  <% end %>
  <%= f.actions do %>
    <%= f.action :submit, label: "Filtrar" %>
  <% end %>
<% end %>